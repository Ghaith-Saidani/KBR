# ==============================
# KBR Application
# ==============================
APP_NAME=KBR API
APP_VERSION=0.1.0
APP_ENV=development

# ==============================
# PostgreSQL
# ==============================
POSTGRES_DB=kbr
POSTGRES_USER=kbr_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==============================
# JWT Authentication
# ==============================
# IMPORTANT:
# Use a long random secret in real environments.
# Never commit your real JWT secret.
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==============================
# CORS
# ==============================
# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173